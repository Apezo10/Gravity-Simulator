{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Gravity Sim",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "local"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Run Gravity Sim",
      "type": "process",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/run.ps1"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$gcc"],
      "presentation": { "focus": true, "panel": "dedicated" }
    }
  ]
}
